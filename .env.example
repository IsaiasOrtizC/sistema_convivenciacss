# Copy this file to .env and replace the placeholders with local credentials.
SECRET_KEY=replace-with-a-random-django-secret
DEBUG=False

# Supabase PostgreSQL connection
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=your-project.supabase.co
DB_PORT=5432

# Optional email and file-storage services
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Celery/Redis (use the Redis URL provided by your hosting provider in production)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# PDF processing and OCR limits
REGLAMENTO_PDF_MAX_BYTES=20971520
REGLAMENTO_PDF_MAX_PAGES=500
REGLAMENTO_PDF_MIN_TEXT_CHARS=30
REGLAMENTO_PDF_MIN_USEFUL_CHARS=30
REGLAMENTO_OCR_MAX_PAGES=50
REGLAMENTO_OCR_DPI=200
REGLAMENTO_OCR_TIMEOUT_SECONDS=30

# Optional: local Tesseract executable and tessdata directory for OCR
TESSERACT_CMD=
TESSDATA_PREFIX=
